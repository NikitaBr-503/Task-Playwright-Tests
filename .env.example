# Copy this file to `.env` and fill in real values. `.env` is git-ignored.

# ---- Application under test -------------------------------------------------
BASE_URL=https://app.precoro.com

# ---- Credentials ------------------------------------------------------------
PRECORO_EMAIL=your.email@example.com
PRECORO_PASSWORD=your-password

# ---- Optional: extra roles for multi-role suites ----------------------------
# PRECORO_APPROVER_EMAIL=
# PRECORO_APPROVER_PASSWORD=

# ---- Runtime knobs ----------------------------------------------------------
# Comma-separated projects, slow-mo, etc. All optional.
HEADLESS=true
SLOW_MO=0
ACTION_TIMEOUT=15000
NAVIGATION_TIMEOUT=45000
EXPECT_TIMEOUT=10000
TEST_TIMEOUT=60000
RETRIES=0
WORKERS=
